{
  "name": "wingman",
  "version": "3.0.0",
  "description": "Personal knowledge and automation server",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p src/tsconfig.build.json",
    "clean": "rm -rf dist",
    "evaluate": "node --env-file-if-exists=.env --import tsx packages/evaluate/index.ts",
    "migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var DATABASE_URL --migrations-dir migrations --check-order --single-transaction",
    "start": "npm run migrate && node --env-file-if-exists=.env dist/src/main.js",
    "test": "vitest run --project fast",
    "test:postgres": "vitest run --project postgres",
    "test:http": "vitest run --project http",
    "test:all": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.12.5",
    "jose": "6.2.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "typebox": "1.3.6",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
