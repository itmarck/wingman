{
  "name": "wingman",
  "version": "3.0.0",
  "description": "Personal log: Entries, Collections and passive notices",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p src/tsconfig.build.json && vite build --config src/panel/vite.config.ts",
    "clean": "rm -rf dist",
    "migrate": "node-pg-migrate up",
    "start": "npm run migrate && node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/panel",
    "container:start": "podman compose up --build -d",
    "container:stop": "podman compose down",
    "container:restart": "podman compose down && podman compose up --build -d"
  },
  "dependencies": {
    "@fastify/static": "9.1.1",
    "@fastify/swagger": "9.8.1",
    "chrono-node": "2.10.2",
    "fastify": "5.12.5",
    "jose": "6.2.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-icons": "1.3.2",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.0",
    "radix-ui": "1.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "7.1.12",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
