{
  "name": "wingman",
  "version": "3.0.0",
  "description": "Personal knowledge and automation server",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p src/tsconfig.build.json",
    "clean": "rm -rf dist",
    "migrate": "node-pg-migrate up",
    "start": "npm run migrate && node dist/src/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "fastify": "5.12.5",
    "jose": "6.2.3",
    "node-pg-migrate": "9.0.0",
    "pg": "8.22.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
