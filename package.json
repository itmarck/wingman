{
  "name": "wingman",
  "version": "2.0.0",
  "description": "Personal knowledge and automation server",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "migrate": "node --env-file-if-exists=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --database-url-var DATABASE_URL --migrations-dir migrations --check-order --single-transaction",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "token": "node --env-file-if-exists=.env --import tsx tools/token.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "fastify": "5.10.0",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "typebox": "1.3.6",
    "uuid": "14.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "25.6.0",
    "@types/pg": "8.20.0",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.18.0"
  }
}
