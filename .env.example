# HTTP
NODE_ENV=development
SERVER_PORT=3000
SERVER_SECRET=replace-with-a-long-random-secret

# System
MUTATION_MODE=approval

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/wingman
POSTGRES_POOL_MAX=10

# Inference
# Local development: gemini.flash. Production: groq.gptoss
# Also supported: openai.luna
INFERENCE_TARGET=gemini.flash
INFERENCE_API_KEY_OPENAI=
INFERENCE_API_KEY_GROQ=
INFERENCE_API_KEY_GEMINI=
